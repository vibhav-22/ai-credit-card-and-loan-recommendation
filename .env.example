# Application Configuration
APP_NAME="FinMatch AI - Credit Card & Loan Recommender"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & CORS
SECRET_KEY="development-secret-key-change-in-production-only"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (Supports PostgreSQL and SQLite fallback)
DATABASE_URL="sqlite:///./finmatch.db"

# LLM Provider Configuration
# Supported providers: "mock", "gemini", "openai", "anthropic"
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"

# Ingestion Settings
INGESTION_USER_AGENT="FinMatchBot/1.0 (+https://finmatch.local/robot)"
REQUEST_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
PAGE_SIZE_LIMIT_BYTES=2097152
ADMIN_API_KEY="admin-secret-dev-key"

# Sarvam AI
SARVAM_API_KEY=
